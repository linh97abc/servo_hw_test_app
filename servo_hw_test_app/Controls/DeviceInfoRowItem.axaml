<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:servo_hw_test_app.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Panel Height="100" Width="500">
            <controls:DeviceInfoRowItem />
        </Panel>
    </Design.PreviewWith>
    <ControlTheme TargetType="controls:DeviceInfoRowItem" x:Key="{x:Type controls:DeviceInfoRowItem}">

        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="A" Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <TextBlock
                        FontSize="14"
                        FontWeight="Medium"

                        Margin="8,0"
                        Text="{TemplateBinding Title}"
                        VerticalAlignment="Center" />

                    <ContentPresenter 
                        Content="{TemplateBinding Content}"
                        HorizontalAlignment="Right" Grid.Column="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>